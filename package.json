{
  "name": "infinite-tictacs",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:prod": "npm run generate && npm run server:build && npm run copy:static",
    "copy:static": "cp -r .output/public server/public",
    "dev": "nuxt dev",
    "dev:host": "nuxt dev --host",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "dev:all:host": "concurrently \"npm run dev:host\" \"npm run server:dev\"",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:install": "cd server && npm install",
    "start": "cd server && npm start",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@motionone/vue": "^10.16.4",
    "howler": "^2.2.4",
    "motion": "^12.23.24",
    "nuxt": "^4.1.2",
    "socket.io-client": "^4.7.5",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/howler": "^2.2.12",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
